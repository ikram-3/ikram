# Ikram Portfolio — Environment Variables Template

# PostgreSQL Database Connection String
# Works with Vercel Postgres, Neon, Supabase, Railway, or local PostgreSQL.
DATABASE_URL="postgresql://postgres:root@localhost:5432/ikram_portfolio?schema=public"

# If using Vercel Postgres directly with pooling, Vercel automatically populates:
# POSTGRES_PRISMA_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
# POSTGRES_URL_NON_POOLING="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# NextAuth secret — generate a secure random string (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET="ikram-portfolio-production-secret-change-this"

# Deployment URL (e.g., https://ikram-portfolio.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Optional: Initial admin credentials for seeding
ADMIN_EMAIL="admin@ikram.local"
ADMIN_NAME="Muhammad Ikram"
ADMIN_PASSWORD="ChangeThisPassword123!"
